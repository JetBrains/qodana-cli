{
  "scheme": [
    {
      "id": "qd.cli.run",
      "type": "counter",
      "version": 1,
      "schema": [
        {
          "event": "started",
          "fields": [
            {
              "path": "command",
              "value": [
                "{enum:init|scan|send|show|contributors}"
              ],
              "dataType": "PRIMITIVE",
              "shouldBeAnonymized": false,
              "description": "CLI command"
            },
            {
              "path": "project_id",
              "value": [
                "{regexp:[-0-9A-Fa-f]+}"
              ],
              "dataType": "PRIMITIVE",
              "shouldBeAnonymized": false,
              "description": "Qodana Cloud project id hash, as Qodana Cloud sends it"
            },
            {
              "path": "org_id",
              "value": [
                "{regexp:[0-9A-Za-z]+}"
