{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "postUpdateOptions": [
    "gomodUpdateImportPaths"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/testdata/**",
    ".teamcity/**"
  ],
  "nuget": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__fixtures__/**",
      "**/testdata/**",
      ".teamcity/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/Dockerfile",
        "**/*.Dockerfile"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s(?:ENV|ARG) .*?_VERSION=\"?(?<currentValue>.*?)\"?\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "internal/tooling/scripts/build-qodana-jbr.go"
      ],
      "matchStrings": [
        "renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\n.*?\"(?<currentValue>.*?)\""
      ],
      "versioningTemplate": "regex:^jbr-release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<revision>\\d+))?b(?<build>.*)$"
    },
    {
      "customType": "regex",
      "description": "Container-engine rows of the CI test matrix.",
      "managerFilePatterns": [
        ".github/workflows/ci.yml"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+container-engine: (?:&\\S+ )?[a-z]+@(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "The pep723 manager doesn't track requires-python.",
      "managerFilePatterns": [
        ".github/actions/setup-docker/normalize-version.py"
      ],
      "matchStrings": [
        "# requires-python = \"==(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "uv-script-python",
      "packageNameTemplate": "python"
    }
  ],
  "pep723": {
    "managerFilePatterns": [
      ".github/actions/setup-docker/normalize-version.py"
    ]
  },
  "customDatasources": {
    "docker-static": {
      "description": "The static binaries .github/actions/setup-docker installs.",
      "defaultRegistryUrlTemplate": "https://download.docker.com/linux/static/stable/x86_64/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "matchManagers": ["gomod", "github-actions", "maven", "gradle", "gradle-wrapper"],
      "commitMessagePrefix": ":arrow_up: QD-12983"
    },
    {
      "matchManagers": ["gomod"],
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["maven", "gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Maven dependencies"
    },
    {
      "matchManagers": ["gomod", "github-actions", "maven", "gradle", "gradle-wrapper"],
      "separateMinorPatch": true
    },
    {
      "matchManagers": ["gomod"],
      "matchCurrentVersion": "!/^v?0\\./",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules (automerge)",
      "automerge": true
    },
    {
      "description": "In 0.y.z a minor may break, but a patch is compatible by convention. 0.0.z and pseudo-versions stay manual.",
      "matchManagers": ["gomod"],
      "matchCurrentVersion": "/^v?0\\.[1-9]\\d*\\.\\d+$/",
      "matchUpdateTypes": ["patch"],
      "groupName": "Go modules (automerge)",
      "automerge": true
    },
    {
      "matchManagers": ["maven", "gradle", "gradle-wrapper"],
      "matchCurrentVersion": "!/^v?0\\./",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Maven dependencies (automerge)",
      "automerge": true
    },
    {
      "description": "In 0.y.z a minor may break, but a patch is compatible by convention. 0.0.z stays manual.",
      "matchManagers": ["maven", "gradle"],
      "matchCurrentVersion": "/^v?0\\.[1-9]\\d*\\.\\d+$/",
      "matchUpdateTypes": ["patch"],
      "groupName": "Maven dependencies (automerge)",
      "automerge": true
    },
    {
      "description": "Kotlin plugins, the serialization runtime that must match them, and the Gradle wrapper (which commits a binary jar). Minors are reviewed.",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchDepNames": ["org.jetbrains.kotlin.jvm", "org.jetbrains.kotlin.plugin.*", "org.jetbrains.kotlinx:kotlinx-serialization-json", "gradle"],
      "groupName": "Kotlin toolchain",
      "automerge": false
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchDepNames": ["org.jetbrains.kotlin.jvm", "org.jetbrains.kotlin.plugin.*", "org.jetbrains.kotlinx:kotlinx-serialization-json", "gradle"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Local embeddings load ONNX Runtime natives; CI never loads the model, so a green build proves nothing here.",
      "matchManagers": ["gradle"],
      "matchDepNames": ["com.microsoft.onnxruntime:*", "ai.djl:*"],
      "groupName": "Edict embeddings",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchCurrentVersion": "!/^v?0\\./",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions (automerge)",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker images"
    },
    {
      "description": "Tools pinned via # renovate: comments in dockerfiles (ENV/ARG *_VERSION), not the base images.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["dockerfiles/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Dockerfile tool versions"
    },
    {
      "description": "Track the GoReleaser Pro action input against the Pro release stream.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["goreleaser/goreleaser"],
      "overrideDepName": "goreleaser/goreleaser-pro",
      "overridePackageName": "goreleaser/goreleaser-pro"
    },
    {
      "description": "Keep the GoReleaser Pro action input and devcontainer tool on one update branch.",
      "matchPackageNames": ["goreleaser/goreleaser-pro"],
      "groupName": "GoReleaser Pro",
      "separateMinorPatch": false
    },
    {
      "description": "Qodana artifacts are only on packages.jetbrains.team. Also querying Central lets a Central 429 abort the run whenever packages.jetbrains.team fails.",
      "matchDatasources": ["maven"],
      "matchPackageNames": ["org.jetbrains.qodana:*", "com.jetbrains.qodana:*"],
      "registryUrls": ["https://packages.jetbrains.team/maven/p/ij/intellij-dependencies"]
    },
    {
      "matchDatasources": ["custom.docker-static"],
      "extractVersion": "^docker-(?<version>\\d+\\.\\d+\\.\\d+)\\.tgz$"
    },
    {
      "description": "uv downloads only the Python builds it knows, so a Python bump may need a uv bump in the same PR.",
      "matchDepNames": ["astral-sh/uv", "uv-script-python"],
      "groupName": "uv and its script Python",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "commitMessagePrefix": ":arrow_up: QD-12983"
    },
    {
      "description": "config-loader-cli.jar in test.yaml needs Java 21; moving to a new major is a deliberate change.",
      "matchDepNames": ["java-jdk"],
      "allowedVersions": "/^21(\\.|$)/"
    },
    {
      "matchDepNames": ["java-jdk"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "ruby.Dockerfile's RUBY_TAG is only a default; the built Ruby versions come from the ruby3x matrix in dockerfiles/base/docker-bake.hcl, which Renovate can't update.",
      "matchPackageNames": ["dhi.io/ruby"],
      "enabled": false
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["mgoltzsche/podman-static", "goreleaser/goreleaser-pro", "cli/cli"],
      "matchManagers": ["custom.regex"],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "description": "Don't bump dependencies to freshly published versions, which protects against hijacked publishes.",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "dhi.io, java-version and the docker-static index publish no release dates; without this the cooldown above holds their updates forever.",
      "matchPackageNames": ["dhi.io/**", "java-jdk", "docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": false
  },
  "commitMessagePrefix": ":arrow_up: QD-8148",
  "schedule": ["* * * * 1"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20
}
